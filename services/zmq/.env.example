ZMQ_CONTAINER_NAME=zmq-service

# Subscribers connect here for Livox point packets.
ZMQ_LIDAR_PUB=tcp://0.0.0.0:5600
# Robot pushes raw Livox Ethernet packets here.
ZMQ_LIDAR_PULL=tcp://0.0.0.0:5601
# Control publishers connect here. JSON {type: cmd_vel|stick|stop}.
ZMQ_CONTROL_SUB=tcp://0.0.0.0:5602
# G1 controller PULL on the robot Wi-Fi address.
ZMQ_CONTROL_PUSH=tcp://10.1.100.211:8082

ZMQ_STATS_SEC=5
