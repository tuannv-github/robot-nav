ROBOT_BRIDGE_CONTAINER_NAME=robot-bridge

# Broker lidar/odom PUB. Multipart [lidar, packet] and [odom, json].
ZMQ_LIDAR_SUB=tcp://127.0.0.1:5600
LIDAR_TOPIC=/livox/lidar
LIDAR_FRAME=livox_frame
LIDAR_FRAME_SEC=0.05
# false: g1_nav deskew_node applies yaw. true would deskew each packet here too.
LIDAR_DESKEW=false
LIDAR_X=0.0
LIDAR_Y=0.0
LIDAR_Z=1.1
LIDAR_ROLL=180
LIDAR_PITCH=0
LIDAR_YAW=0
ODOM_FRAME=odom
# Torso estimator is /odom and odom -> base_link.
ODOM_FORWARD=true
# Broadcast odom -> base_link when ODOM_FORWARD is true.
PUBLISH_ODOM_TF=true
# First /odom sample after this process starts becomes the TF origin.
ODOM_ZERO_START=true
# Hold odom -> base_link z at 0. Estimator z is a datum and drifts.
ODOM_FIXED_Z=true
# Broker control PUB. Same JSON the G1 controller receives.
ZMQ_CONTROL_SUB=tcp://127.0.0.1:5603
CMD_VEL_TOPIC=/cmd_vel
IDLE_TIMEOUT_SEC=0.5

# G1 stick scales: vx = ly * linear, vy = -lx * linear, w = -rx * yaw.
STICK_LINEAR_SCALE=0.6
STICK_YAW_SCALE=1.0

ROS_DOMAIN_ID=0
# Match this machine's `ros2 topic list` (Humble here is FastRTPS).
# Use rmw_cyclonedds_cpp plus DDS_INTERFACE / DDS_PEERS for the robot graph.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
DDS_INTERFACE=ens12f0
DDS_PEERS=10.1.100.220
